{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "automergeStrategy": "merge-commit",
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    "spec/apps/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/*.{yml,yaml}"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+.*@(?<currentValue>[^\\s@]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}npm{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/test.yml"
      ],
      "matchStrings": [
        "- ruby: (?<depName>ruby):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "ruby"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "rails",
        "rspec-rails",
        "hanami",
        "dry-logger"
      ]
    },
    {
      "description": [
        "The Gemfile caps json below 3. json 3 raises ArgumentError on the quirks_mode option that Rails 8.0 and older pass.",
        "Remove this rule and the cap when the oldest Rails in the test matrix is 8.1 or later."
      ],
      "enabled": false,
      "matchPackageNames": [
        "json"
      ]
    },
    {
      "description": [
        "The Gemfile caps prism below 2 on Ruby older than 3.0. Bundler 2.1 in the ruby:2.7 image picks the native prism 2 gem, which needs Ruby 3.3.",
        "Remove this rule and the cap when Ruby 2.7 leaves the test matrix."
      ],
      "enabled": false,
      "matchPackageNames": [
        "prism"
      ]
    }
  ]
}
